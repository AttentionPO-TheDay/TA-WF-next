__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.experiment.lock
.status.lock
.env
.env.*
!.env.example
.DS_Store

# Shared/raw data and generated model payloads stay local.
data/
datasets/
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.safetensors
*.pcap
*.pcapng

# Keep plans, configs, source scripts, reports and compact JSON summaries.
# Large generated tables and per-sample evidence remain on disk, outside Git.
# Selected compact evidence is explicitly tracked; see docs/EVIDENCE_ARCHIVE.md
# and docs/evidence_manifest.json. Keep the broad exclusions for new payloads.
runs/*/checkpoints/
runs/*/logs/
# Runtime output may use ``lgs`` plus a ``logs`` compatibility symlink.
runs/*/lgs/
runs/*/logs
runs/**/*.log
runs/*/artifacts/
runs/**/*.csv

# Generated figures and runtime locks stay local.
/*.lock
runs/**/*.pdf
runs/**/*.png
runs/**/*.svg
